{
  "name": "khmer-micro-store",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @khmer-micro-store/db migrate:dev",
    "db:deploy": "pnpm --filter @khmer-micro-store/db migrate:deploy",
    "admin:add-owner": "pnpm --filter @khmer-micro-store/api admin:add-owner",
    "s3:up": "infra\\local-s3.cmd",
    "files:setup": "pnpm --filter @khmer-micro-store/api files setup",
    "files:check": "pnpm --filter @khmer-micro-store/api files check",
    "files:copy-to-s3": "pnpm --filter @khmer-micro-store/api files copy-to-s3",
    "db:backup": "pnpm --filter @khmer-micro-store/worker backup",
    "db:restore": "pnpm --filter @khmer-micro-store/worker restore"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
