    "@sentry/node": "^8",
    "pg-boss": "^10",
    "pino": "^9"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "eslint": "^8.57.0",
    "tsup": "^8",
    "tsx": "^4.19.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
