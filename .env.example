# Copy to .env (in the repo root) and fill in for local development. Never commit .env.
# The API and worker check these at start-up (packages/shared/src/env.ts) and
# stop with a list of what's missing.

NODE_ENV=development
LOG_LEVEL=info

# Database: the API, the worker and its job queue (pg-boss) all use this one.
DATABASE_URL="postgresql://khmer_micro_store:khmer_micro_store@localhost:5432/khmer_micro_store"

# API (apps/api)
PORT=4000
# The only site allowed to call the API from a browser.
WEB_ORIGIN="http://localhost:3000"

# Web (apps/web)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Error tracking: leave empty to keep errors on this machine.
SENTRY_DSN=

# Telegram (merchant login + alerts) - roadmap steps 2 and 6
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Bakong Open API - roadmap step 5
BAKONG_OPEN_API_TOKEN=

# ABA PayWay - Release 3
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=

# Secrets
SESSION_SECRET=
PAYWAY_KEY_ENCRYPTION_KEY=
