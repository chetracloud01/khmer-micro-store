# Copy to .env (in the repo root) and fill in for local development. Never commit .env.
# The API and worker check these at start-up (packages/shared/src/env.ts) and
# stop with a list of what's missing. First time on Windows without Docker:
# run infra/setup-local-db.cmd to create the database users.

NODE_ENV=development
LOG_LEVEL=info

# Database — two users (docs/blueprint.md "Multi-tenant safety"):
# the API's everyday user, kept to one shop's rows by row-level security...
DATABASE_URL="postgresql://khmer_micro_store_app:khmer_micro_store_app@localhost:5432/khmer_micro_store"
# ...and the owner: migrations, the worker, and the API's login and sign-up.
DATABASE_OWNER_URL="postgresql://khmer_micro_store:khmer_micro_store@localhost:5432/khmer_micro_store"

# API (apps/api)
PORT=4000
# The web app: the only site(s) allowed to call the API from a browser; the first is the base of links
# in Telegram alerts. Several, comma-separated, to test on a phone: http://localhost:3000,http://192.168.x.x:3000
WEB_ORIGIN="http://localhost:3000"

# Photos: kept in this folder while developing and served by the API's /files.
# Production keeps them in Cloudflare R2 (roadmap step 8).
FILES_DIR=.uploads
# FILES_PUBLIC_URL=        (unset = http://localhost:<PORT>/files)

# Error tracking: leave empty to keep errors on this machine.
SENTRY_DSN=

# Telegram bot (from @BotFather): login and order alerts. Empty = Telegram login off (the development
# login still works) and the worker only logs the alerts it would send (dry run).
TELEGRAM_BOT_TOKEN=

# Admin two-step login: encrypts each admin's authenticator secret. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Empty = the admin login is off. Lost = every admin sets up two-step login again (pnpm admin:add-owner).
ADMIN_SECRETS_KEY=

# Bakong Open API - roadmap step 5
BAKONG_OPEN_API_TOKEN=

# ABA PayWay - Release 3
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_KEY_ENCRYPTION_KEY=

# Web (apps/web) reads its own apps/web/.env.local, not this file:
#   NEXT_PUBLIC_API_URL=http://localhost:4000        (default if unset)
#   NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_name  (shows the Telegram button)
