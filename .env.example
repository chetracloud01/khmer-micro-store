# Copy to .env and fill in for local development. Never commit .env.

# Database (packages/db)
DATABASE_URL="postgresql://khmer_micro_store:khmer_micro_store@localhost:5432/khmer_micro_store"

# Redis (apps/worker, BullMQ)
REDIS_HOST="localhost"
REDIS_PORT="6379"

# API (apps/api)
PORT=4000

# Web (apps/web)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Telegram (merchant login + alerts) - Stage C/G
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Bakong Open API - Stage E
BAKONG_OPEN_API_TOKEN=

# ABA PayWay - Stage F
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=

# Secrets
SESSION_SECRET=
PAYWAY_KEY_ENCRYPTION_KEY=
